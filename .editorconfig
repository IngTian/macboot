# macboot — editor settings, so an editor and `shfmt -i 2 -ci` agree and a commit
# does not carry a whitespace-only diff of somebody else's file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 2 spaces, matching `make fmt` (shfmt -i 2 -ci). A tab-indented script still
# passes shellcheck, so nothing but this file catches the disagreement.
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

# make requires literal tabs in recipes: spaces there are a "missing separator"
# error, so an editor set to expand tabs breaks the build.
[Makefile]
indent_style = tab

# Two trailing spaces are a hard line break in Markdown; stripping them silently
# reflows the paragraph.
[*.md]
trim_trailing_whitespace = false

# No .tsv is shipped any more — apps.tsv went with the installer, and the GUI apps it
# listed are prose in docs/tools.md now. The rule stays because tab-separated data is
# the one format where trimming trailing whitespace silently corrupts a row: an empty
# final column ends in a literal tab, and stripping it shifts every field left.
[*.tsv]
trim_trailing_whitespace = false
indent_style = tab
