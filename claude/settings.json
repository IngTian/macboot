{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(bash -n:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(defaults read:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(defaults write:*)",
      "Bash(defaults delete:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm -R -f:*)",
      "Bash(rm -f -R:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(rm --force --recursive:*)",
      "Bash(sudo rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear)",
      "Bash(git filter-branch:*)",
      "Bash(git rebase -i:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(diskutil erase:*)",
      "Bash(chmod -R 777:*)",
      "Bash(defaults delete com.apple.finder)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*id_rsa*)",
      "Read(./**/*id_ed25519*)",
      "Read(./**/.netrc)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/shfmt-on-write.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
